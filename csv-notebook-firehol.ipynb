import os
import subprocess
import glob
import pandas as pd
import ipaddress

# ========================================== takes in csv spits out csv
# 1. Clone or Update Threat Intel Repository
# ========================================== by gemini

REPO_URL = "https://github.com/firehol/blocklist-ipsets.git"
REPO_DIR = "blocklist-ipsets"
INPUT_LOGS_CSV = "network_logs.csv"

if not os.path.exists(REPO_DIR):
    print(f"[+] Cloning repository '{REPO_URL}'...")
    subprocess.run(["git", "clone", "--depth", "1", REPO_URL, REPO_DIR], check=True)
else:
    print(f"[+] Repository '{REPO_DIR}' already exists. Fetching latest updates...")
    subprocess.run(["git", "-C", REPO_DIR, "pull"], check=True)


# ==========================================
# 2. Parse All Local .netset and .ipset Data
# ==========================================

single_threat_ips = set()
cidr_threat_networks = []

# Gather all .netset and .ipset files from the cloned repository
intel_files = glob.glob(os.path.join(REPO_DIR, "*.netset")) + glob.glob(os.path.join(REPO_DIR, "*.ipset"))

print(f"[+] Ingesting threat lists from {len(intel_files)} local files...")

for file_path in intel_files:
    try:
        with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                # Ignore empty lines and header/comment lines
                if not line or line.startswith("#"):
                    continue
                
                # Sort entries into single IPs or CIDR networks
                if "/" in line:
                    try:
                        cidr_threat_networks.append(ipaddress.ip_network(line, strict=False))
                    except ValueError:
                        pass
                else:
                    single_threat_ips.add(line)
    except Exception as e:
        print(f"[-] Warning: Failed to read {file_path}: {e}")

print(f"[+] Ingestion complete:")
print(f"    - Unique Single Threat IPs loaded: {len(single_threat_ips):,}")
print(f"    - Total CIDR Threat Subnets loaded: {len(cidr_threat_networks):,}")


# Helper function to match IP against single IPs and CIDRs
def check_ip_against_intel(ip_str):
    if not ip_str or ip_str == "nan":
        return False
    
    try:
        ip_obj = ipaddress.ip_address(ip_str)
    except ValueError:
        return False

    # 1. Fast O(1) set check for single IP matches
    if str(ip_obj) in single_threat_ips:
        return True

    # 2. Iterative check for CIDR subnet block matches
    for network in cidr_threat_networks:
        if ip_obj in network:
            return True
            
    return False


# ==========================================
# 3. Data Ingestion & Fallback Sample Data
# ==========================================

try:
    logs_df = pd.read_csv(INPUT_LOGS_CSV)
    print(f"[+] Successfully loaded '{INPUT_LOGS_CSV}' with {len(logs_df)} records.")
except FileNotFoundError:
    print(f"[!] '{INPUT_LOGS_CSV}' not found. Generating sample logs for demonstration...")
    
    sample_data = {
        "timestamp": ["2026-03-29 10:00:00", "2026-03-29 10:01:15", "2026-03-29 10:02:30", "2026-03-29 10:05:00"],
        "source.ip": ["192.168.1.50", "185.220.101.5", "10.0.0.12", "192.168.1.100"],
        "destination.ip": ["8.8.8.8", "192.168.1.10", "45.154.255.120", "1.1.1.1"],
        "port": [443, 80, 22, 53],
        "protocol": ["TCP", "TCP", "SSH", "UDP"]
    }
    logs_df = pd.DataFrame(sample_data)


# ==========================================
# 4. Enrichment & Threat Matching
# ==========================================

# Clean IP fields
logs_df["source.ip"] = logs_df["source.ip"].astype(str).str.strip()
logs_df["destination.ip"] = logs_df["destination.ip"].astype(str).str.strip()

print("\n[+] Scanning logs against local repository threat feeds...")

# Match source and destination IPs against ingested intel
logs_df["src_ip_is_threat"] = logs_df["source.ip"].apply(check_ip_against_intel)
logs_df["dst_ip_is_threat"] = logs_df["destination.ip"].apply(check_ip_against_intel)

# Flag rows matching either source OR destination IP
logs_df["is_threat_match"] = logs_df["src_ip_is_threat"] | logs_df["dst_ip_is_threat"]

# Categorize match location
def classify_threat(row):
    if row["src_ip_is_threat"] and row["dst_ip_is_threat"]:
        return "Both"
    elif row["src_ip_is_threat"]:
        return "Source IP"
    elif row["dst_ip_is_threat"]:
        return "Destination IP"
    return "None"

logs_df["threat_match_type"] = logs_df.apply(classify_threat, axis=1)


# ==========================================
# 5. Display & Export Results
# ==========================================

# Filter for threat matches
threat_matches_df = logs_df[logs_df["is_threat_match"]].copy()

print("\n" + "="*60)
print(" REPOSITORY-WIDE THREAT INTEL DETECTION SUMMARY")
print("="*60)
print(f"Total Log Records Analyzed : {len(logs_df):,}")
print(f"Threat Matches Detected    : {len(threat_matches_df):,}")
print("="*60)

# Display matched logs in notebook output
print("\n[+] Matched Threat Logs:")
display(threat_matches_df)

# Export output CSVs
logs_df.to_csv("enriched_network_logs.csv", index=False)
threat_matches_df.to_csv("git_threat_matches_only.csv", index=False)

print("\n[+] Export Complete:")
print(" - Full enriched log file: 'enriched_network_logs.csv'")
print(" - Threat alerts file: 'git_threat_matches_only.csv'")
